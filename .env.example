# ==============================================================================
# Environment Configuration Template (Evidence Galaxy / KBase_superjoin)
# Copy this file to .env and supply your API credentials.
# At least ONE LLM provider key (Groq, Gemini, or Cerebras) is required.
# ==============================================================================

# --- LLM Providers (Multi-Key Round-Robin Rotation Supported) ---

# Groq (Llama-3.3-70b / DeepSeek) - Recommended for low-latency reasoning
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Google Gemini (Gemini Flash / Gemini Pro)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Cerebras (Ultra-Fast Wafer-Scale Inference)
CEREBRAS_API_KEY_1=your_cerebras_api_key_here
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=

# --- Local & Privacy Modes (Optional) ---
# When PRIVACY_MODE is true, cloud LLM calls are disabled and routed to local Ollama
PRIVACY_MODE=false
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# --- Graph Database & Audit Logging (Optional) ---
# System runs with in-memory NetworkX graph by default; Neo4j is optional for persistence
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# MongoDB Atlas (Optional audit trail storage)
MONGO_URI=

# --- Remote Asset Storage (Optional) ---
# PDF previews are rendered and served locally (<2ms); Cloudinary is optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
