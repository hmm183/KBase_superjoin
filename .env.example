# ==============================================================================
# Environment Configuration Template (KBase_superjoin)
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Authentication & Session Secrets
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/superjoin

# Neo4j Graph Database
NEO4J_URI=neo4j+s://<instance_id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Email / Alerts
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL=your_email@gmail.com

# Multi-Key Rotation: Google Gemini
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5

# Multi-Key Rotation: Groq (Llama-3.3-70b / DeepSeek)
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
GROQ_API_KEY_3=your_groq_api_key_3
GROQ_API_KEY_4=your_groq_api_key_4
GROQ_API_KEY_5=your_groq_api_key_5

# Multi-Key Rotation: Cerebras (Ultra-Fast Inference)
CEREBRAS_API_KEY_1=your_cerebras_api_key_1
CEREBRAS_API_KEY_2=your_cerebras_api_key_2
CEREBRAS_API_KEY_3=your_cerebras_api_key_3
CEREBRAS_API_KEY_4=your_cerebras_api_key_4
CEREBRAS_API_KEY_5=your_cerebras_api_key_5

# Cloudinary (PDF & Image Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS Notifications (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key
